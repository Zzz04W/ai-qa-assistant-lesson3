{
  "version": "1.0",
  "threshold": 0.35,
  "no_hit": {
    "action": "拒答",
    "message": "本助手未在课程 FAQ 中找到相关问题，建议换一种问法或咨询课程负责人。"
  },
  "low_confidence": {
    "action": "拒答",
    "condition": "最高匹配得分 < threshold",
    "message": "问题与课程资料的匹配度较低，为避免编造答案，本助手不予回答；请咨询课程负责人或换一种问法。"
  },
  "tie": {
